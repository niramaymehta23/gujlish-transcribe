*.pem
*.key
.DS_Store
# Everything private lives in data/: recordings, transcripts, channel.md, youtube_footer.txt and the correction
# dictionary. Only the empty folder is shared. The root entries catch files left in the old places.
data/*
!data/.gitkeep
/recordings/
/transcripts/
/channel.md
/youtube_footer.txt
/dictionary.json
/dictionary-clips/
# The studio's talks, media and channel rules; only its tools and instructions are shared.
studio/inbox/*
!studio/inbox/.gitkeep
studio/talks/*
!studio/talks/.gitkeep
studio/rules/*
!studio/rules/*.example.md
studio/remotion/node_modules/
studio/remotion/out/
# Model weights and local exports should never be committed accidentally.
*.safetensors
*.pt
*.pth
*.onnx
*.nemo
*.mlmodel
